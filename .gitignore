/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ss]erver[Dd]ata/

# OS
.DS_Store
Thumbs.db

# Windows/Drive artefakter
desktop.ini

# Renderade skärmbilder. PNG ligger i Git LFS enligt .gitattributes, och bilderna
# byggs om deterministiskt ur fröet med Tools/render_screens.py — se
# docs/screenshots/README.md.
/docs/screenshots/*.png

# Python-verktygen i Tools/
__pycache__/

# Build output from Tools/csharp/typecheck.sh. The .dll and .obj patterns in
# .gitattributes send these to Git LFS, so committing them fails the push outright.
Tools/csharp/bin/
Tools/csharp/obj/

# Build output from Tools/csharp/typecheck.sh, kept out for a specific reason: the
# .dll and .obj patterns in .gitattributes send anything matching to Git LFS, and the
# LFS endpoint is unreachable from some of the environments this is worked on in — so
# committing build output does not merely add noise, it fails the push outright.
#
# Typecheck.csproj itself is force-added: *.csproj above is meant for the ones Unity
# regenerates inside the project, and this one is a tool that has to be in the repo.
