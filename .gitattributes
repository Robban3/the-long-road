* text=auto eol=lf

# Unity serialises scenes, prefabs and assets as YAML. Keeping them as text is what
# makes diffs and merges possible at all; marking them binary would turn every scene
# edit into an unresolvable conflict.
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.asmdef    text
*.json      text
*.md        text
*.meta      text merge=unityyamlmerge eol=lf
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf

# Binaries go to LFS. Git stores no useful delta between two versions of an FBX or a
# texture, so without this every re-import of an art pack adds its full size to the
# history permanently.
*.fbx       filter=lfs diff=lfs merge=lfs -text

# Except the borrowed-clips folder, which git carries directly.
#
# Not a preference about LFS. This folder holds hand-dropped Mixamo downloads — one
# animation each, a few hundred kilobytes, no skin — and it is the one place in the
# project that gets written to from a sandbox whose network policy refuses
# lfs.github.com. Under the rule above the pointer commits and the object cannot be
# uploaded, which leaves the repository holding a pointer to nothing: worse than either
# storing the bytes or not committing at all. The argument for LFS is re-imported art
# packs adding their full size to the history on every version, and none of that applies
# to a file that is downloaded once and never touched again.
Assets/_Project/Animation/Humanoid/** -filter -diff -merge -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
